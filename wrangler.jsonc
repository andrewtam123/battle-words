{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "battle-words-api",
  "main": "server/index.js",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "BattleRoom" }]
  },
  "exports": {
    "BattleRoom": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://andrewtam123.github.io,http://127.0.0.1:4173,http://localhost:4173"
  }
}
